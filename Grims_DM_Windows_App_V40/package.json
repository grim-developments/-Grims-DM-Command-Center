{
  "name": "grims-dm-command-center",
  "version": "1.0.43",
  "private": true,
  "description": "Grim’s DM Command Center — public Windows desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "test:syntax": "node --check main.js && node --check preload.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.grims.dmcommandcenter",
    "productName": "Grims DM Command Center",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "welcome-scenes/**/*",
      "update-config.json",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Grims-DM-Command-Center-${version}-${arch}.${ext}",
      "icon": "assets/grim-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "runAfterFinish": true,
      "installerIcon": "assets/grim-icon.ico",
      "uninstallerIcon": "assets/grim-icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "grim-developments",
        "repo": "-Grims-DM-Command-Center"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
